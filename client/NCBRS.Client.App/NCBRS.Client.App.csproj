<Project Sdk="Microsoft.NET.Sdk">

  <!-- WS-B, the Tier-1 facility/village device shell (B1 decision: MAUI).
       DELIBERATELY NOT in NCBRS.slnx: most CI jobs build the solution with no
       MAUI workload, and a MAUI project there would fail every one of them.
       CI's "Build (MAUI Android)" job builds this project on its own, with the
       workload installed. Locally:
         dotnet workload install maui-android maui-windows
         dotnet build client/NCBRS.Client.App -f net10.0-android
       See README.md in this folder. -->

  <PropertyGroup>
    <!-- Android is the tablet. Windows is the desktop dev loop on a Windows
         machine, so a screen can be worked on without an emulator. iOS and
         Mac Catalyst are not targets: the fleet is Android, and neither can be
         built on the machines this is developed and built on. -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NCBRS.Client.App</RootNamespace>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>NCBRS</ApplicationTitle>
    <ApplicationId>ss.gov.ncbrs.client</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Unpackaged: the Windows head is a dev loop, not a distribution. -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1B5E20" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1B5E20" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <!-- The offline-first logic. The shell adds screens, the encrypted store and
       printing; it holds no registration logic of its own. -->
  <ItemGroup>
    <ProjectReference Include="../NCBRS.Client.Core/NCBRS.Client.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

</Project>
