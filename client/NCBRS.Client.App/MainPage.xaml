<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NCBRS.Client.App.MainPage"
             Title="Register a birth">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="NCBRS — offline registration"
                   FontSize="20" FontAttributes="Bold" />
            <Label FontSize="12"
                   Text="Scaffold demonstrating the shell driving FacilityClient (client-core). A real session loads the device key, BRN block and outbox from the encrypted store after PIN unlock." />

            <Entry x:Name="ChildName" Placeholder="Child's full name" />
            <Button Text="Register" Clicked="OnRegister" />

            <Label x:Name="Result" FontSize="16" />
            <Label x:Name="StatusLine" FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
