<?xml version="1.0" encoding="UTF-8" ?>
<!-- The palette, mirrored in Pages/Ui.cs for the views built in code. Around
     the Ministry green; text and surfaces chosen to pass WCAG AA in sun. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="Primary">#1B5E20</Color>
    <Color x:Key="PrimaryDark">#103D14</Color>
    <Color x:Key="Secondary">#2E7D32</Color>
    <Color x:Key="Background">#F3F5F4</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Text">#17201A</Color>
    <Color x:Key="TextMuted">#56625B</Color>
    <Color x:Key="Border">#D9E0DB</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
</ResourceDictionary>
