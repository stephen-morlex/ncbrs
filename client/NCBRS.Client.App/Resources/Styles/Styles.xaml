<?xml version="1.0" encoding="UTF-8" ?>
<!-- Implicit styles: the floor every control stands on, so a page that builds
     its own controls still reads as the rest of the app does. The particular
     pieces (cards, chips, tabs, the bottom bar) are in Pages/Ui.cs and
     Pages/Controls.cs.

     Fonts are dynamic resources (FontRegular, FontSemiBold), set by
     AppLanguage: Geist for English, Noto Sans Arabic for Arabic, which Geist
     does not draw. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="BarTextColor" Value="{StaticResource White}" />
    </Style>

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Background}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Foreground}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontRegular}" />
    </Style>

    <!-- The main action: 56 tall, the tablet is used one-handed and in a hurry. -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryForeground}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontSemiBold}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="{DynamicResource FontRegular}" />
        <Setter Property="TextColor" Value="{StaticResource Foreground}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource MutedForeground}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="{DynamicResource FontRegular}" />
        <Setter Property="TextColor" Value="{StaticResource Foreground}" />
        <Setter Property="TitleColor" Value="{StaticResource MutedForeground}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="{DynamicResource FontRegular}" />
        <Setter Property="TextColor" Value="{StaticResource Foreground}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource Primary}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="MinimumWidthRequest" Value="48" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Primary}" />
    </Style>

</ResourceDictionary>
