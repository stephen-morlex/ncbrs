{
  "realm": "ncbrs",
  "enabled": true,
  "displayName": "NCBRS",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "offlineSessionIdleTimeout": 5184000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 15552000,
  "roles": {
    "realm": [
      {
        "name": "facility-registrar",
        "description": "Registers births at their own facility. Maps to RegistrarRole.FacilityRegistrar. Holds offline_access: a tablet's sign-in must outlive weeks without connectivity.",
        "composite": true,
        "composites": { "realm": ["offline_access"] }
      },
      {
        "name": "community-health-worker",
        "description": "Registers births in the community for their facility. Maps to RegistrarRole.CommunityHealthWorker. Holds offline_access, as a registrar.",
        "composite": true,
        "composites": { "realm": ["offline_access"] }
      },
      {
        "name": "district-officer",
        "description": "Oversees the facilities in a district; may act across them. Maps to RegistrarRole.DistrictOfficer."
      },
      {
        "name": "ministry-admin",
        "description": "National administration; may act across all facilities. Maps to RegistrarRole.MinistryAdmin."
      }
    ]
  },
  "clients": [
    {
      "clientId": "ncbrs-web",
      "name": "NCBRS central management site",
      "description": "Central management site (plan W6). Public client, authorization code with PKCE. Direct access grants are off on purpose - see NCBRS-Web-Plan.md section 4.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://127.0.0.1:5173/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "ncbrs-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ncbrs-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "ncbrs-county-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "ncbrs-device",
      "name": "NCBRS facility device",
      "description": "Facility tablet app. Signs in once (code + PKCE) and holds an offline token for weeks offline. Password grant is dev-only; see RUNBOOK 'Deployment: Keycloak realm'.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "ss.gov.ncbrs.client://auth/callback",
        "http://127.0.0.1:53682/auth"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "ncbrs-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ncbrs-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "ncbrs-county-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "ncbrs-district",
      "name": "NCBRS District node",
      "description": "A District store-and-forward node. Confidential: signs in as itself with client credentials, never as a person. The secret here is a dev fixture.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-district-node-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "ncbrs-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ncbrs-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "ncbrs-county-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
