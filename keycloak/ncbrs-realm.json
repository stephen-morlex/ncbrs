{
  "realm": "ncbrs",
  "enabled": true,
  "displayName": "NCBRS",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "offlineSessionIdleTimeout": 5184000,
  "roles": {
    "realm": [
      {
        "name": "facility-registrar",
        "description": "Registers births at their own facility. Maps to RegistrarRole.FacilityRegistrar."
      },
      {
        "name": "community-health-worker",
        "description": "Registers births in the community for their facility. Maps to RegistrarRole.CommunityHealthWorker."
      },
      {
        "name": "district-officer",
        "description": "Oversees the facilities in a district; may act across them. Maps to RegistrarRole.DistrictOfficer."
      },
      {
        "name": "ministry-admin",
        "description": "National administration; may act across all facilities. Maps to RegistrarRole.MinistryAdmin."
      }
    ]
  },
  "clients": [
    {
      "clientId": "ncbrs-web",
      "name": "NCBRS central management site",
      "description": "Central management site (plan W6). Public client, authorization code with PKCE. Direct access grants are off on purpose - see NCBRS-Web-Plan.md section 4.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://127.0.0.1:5173/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "ncbrs-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ncbrs-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "ncbrs-device",
      "name": "NCBRS facility device",
      "description": "The tablet/phone app used at facilities and village posts.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "ncbrs-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ncbrs-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
