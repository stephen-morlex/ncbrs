<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Namespaces stay NCBRS.* across every project, so a file moved here from
         NCBRS.Core needs no source change. -->
    <RootNamespace>NCBRS</RootNamespace>
  </PropertyGroup>

  <!-- Deliberately dependency-light: the vital-statistics models and the
       certificate verifier live here so the Tier-1 facility device app can
       reference them without dragging in Kafka, Npgsql or EF Core, which do
       not belong on an offline Android tablet. This is what keeps the
       canonical signed-certificate form in one place rather than reimplemented
       on the device, where it could drift. Only the BCL is referenced. -->

</Project>
