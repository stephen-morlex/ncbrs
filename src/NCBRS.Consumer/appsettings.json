{
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/ncbrs",
    "Audience": "ncbrs-api"
  },
  "WebClientCors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "ReadModel": "Data Source=../../ncbrs-readmodel.db"
  },
  "Dhis2Export": {
    "MinimumCellSize": 5
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "BirthRecordsRegisteredTopic": "ncbrs.birth-records.registered",
    "BirthRecordsAmendedTopic": "ncbrs.birth-records.amended",
    "BirthRecordsAnnulledTopic": "ncbrs.birth-records.annulled",
    "NeonatalOutcomesTopic": "ncbrs.outcomes.neonatal",
    "MaternalOutcomesTopic": "ncbrs.outcomes.maternal",
    "SyncAuditTopic": "ncbrs.sync.audit",
    "ConsumerGroupId": "ncbrs-dashboard-updater"
  }
}
