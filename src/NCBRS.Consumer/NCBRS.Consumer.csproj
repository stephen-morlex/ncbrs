<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NCBRS</RootNamespace>
    <UserSecretsId>ncbrs-Consumer</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared framework, not a package: this service serves dashboard
         queries over the read model it owns. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NCBRS.Core\NCBRS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- W8: the dashboard and export endpoints need a document, or the
         generated web client cannot cover them. -->
    <!-- W9: the dashboard serves national vital statistics and had no
         authentication at all. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

</Project>
