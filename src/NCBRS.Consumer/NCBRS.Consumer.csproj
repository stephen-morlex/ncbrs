<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NCBRS</RootNamespace>
    <UserSecretsId>ncbrs-Consumer</UserSecretsId>

    <!-- Same arrangement as NCBRS.Api: the document is written at build time
         beside the web app, so the committed copy cannot drift from the
         endpoints it describes. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../web/openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared framework, not a package: this service serves dashboard
         queries over the read model it owns. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NCBRS.Core\NCBRS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- W8: the dashboard and export endpoints need a document, or the
         generated web client cannot cover them. -->
    <!-- W9: the dashboard serves national vital statistics and had no
         authentication at all. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Writes the document at build time for the generated web client.
         Build-time only; it ships nothing. -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
