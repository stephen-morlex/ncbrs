<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NCBRS</RootNamespace>
    <UserSecretsId>ncbrs-District</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Core is referenced for the sync DTOs only. The node deliberately does
      not carry NcbrsDbContext: see DistrictDbContext for why a district box
      holds no registry tables.
    -->
    <ProjectReference Include="..\NCBRS.Core\NCBRS.Core.csproj" />
  </ItemGroup>

</Project>
