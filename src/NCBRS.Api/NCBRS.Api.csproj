<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NCBRS</RootNamespace>

    <!-- Written beside the web app that consumes it. This is what stops the
         committed document drifting from the code: the build regenerates it
         from the real endpoints, and CI fails on a difference, so a
         controller change nobody regenerated cannot reach main. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../web/openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NCBRS.Core\NCBRS.Core.csproj" />
    <!-- Referenced so the Postgres migration history is loadable at runtime;
         the API applies migrations in Development and `dotnet ef database
         update` needs it as a deployment step elsewhere. -->
    <ProjectReference Include="..\NCBRS.Migrations.Postgres\NCBRS.Migrations.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- Needed by the EF tools because the DbContext lives in Core while the
         API is the startup project: Core marks Design PrivateAssets, so it
         does not flow through the project reference. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Writes the OpenAPI document during build, so the committed copy under
         web/openapi cannot drift from the code: the build regenerates it and
         CI fails on a difference. Build-time only; it ships nothing. -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The UI only. The generator is Microsoft.AspNetCore.OpenApi above,
         shared with NCBRS.Consumer so both services emit OpenAPI 3.1 and one
         client generator can read both documents. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

</Project>
