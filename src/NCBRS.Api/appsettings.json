{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "BirthRecordsRegisteredTopic": "ncbrs.birth-records.registered",
    "ConsumerGroupId": "ncbrs-dashboard-updater"
  },
  "CertificateSigning": {
    "KeyId": "ncbrs-dev"
  },
  "StatutoryRegistration": {
    "WindowDays": 90
  },
  "DeviceEnrolment": {
    "Required": true,
    "WebClientId": "ncbrs-web"
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/ncbrs",
    "Audience": "ncbrs-api"
  }
}
