{
  "WebClientCors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=../../ncbrs.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/ncbrs",
    "RequireHttpsMetadata": false
  },
  "CertificateSigning": {
    "AllowEphemeralDevelopmentKey": true
  },
  "DeviceEnrolment": {
    "RequireSignature": false
  }
}
