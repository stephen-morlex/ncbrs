{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=../../ncbrs.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Keycloak": {
    "RequireHttpsMetadata": false
  },
  "CertificateSigning": {
    "AllowEphemeralDevelopmentKey": true
  },
  "DeviceEnrolment": {
    "RequireSignature": false
  }
}
