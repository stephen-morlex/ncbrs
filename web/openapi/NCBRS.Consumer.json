          "districtId": {
            "type": [
              "null",
              "string"
            ]
          },
          "registrations": {
            "$ref": "#/components/schemas/RegistrationCounts"
          },
          "timeliness": {
            "$ref": "#/components/schemas/Timeliness"
          },
          "timeToConfirmation": {
            "$ref": "#/components/schemas/TimeToConfirmation"
          },
          "registrationDelay": {
            "$ref": "#/components/schemas/RegistrationDelay"
          },
          "mortality": {
            "$ref": "#/components/schemas/Mortality"
          },
          "sync": {
