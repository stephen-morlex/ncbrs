        "type": "object",
        "properties": {
          "batches": {
            "type": "integer",
            "format": "int32"
          },
          "devicesReporting": {
            "type": "integer",
            "format": "int32"
          },
          "recordsSubmitted": {
            "type": "integer",
            "format": "int32"
          },
          "recordsRegistered": {
            "type": "integer",
            "format": "int32"
          },
          "recordsRejected": {
            "type": "integer",
            "format": "int32"
          },
          "registeredShare": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          }
        }
      },
      "TierRegistrationDelay": {
        "required": [
          "facilityTier",
          "measured",
          "medianDaysBirthToRegistration",
          "medianDaysRegistrationToCentre"
        ],
        "type": "object",
        "properties": {
          "facilityTier": {
            "type": "string"
          },
          "measured": {
            "type": "integer",
            "format": "int32"
          },
          "medianDaysBirthToRegistration": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "medianDaysRegistrationToCentre": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          }
        }
      },
      "TierTimeToConfirmation": {
        "required": [
          "facilityTier",
          "confirmed",
          "medianDays"
        ],
        "type": "object",
        "properties": {
          "facilityTier": {
            "type": "string"
          },
          "confirmed": {
            "type": "integer",
            "format": "int32"
          },
          "medianDays": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          }
        }
      },
      "Timeliness": {
        "required": [
          "withinWindow",
          "outsideWindow",
          "unknown",
          "withinWindowShare"
        ],
        "type": "object",
        "properties": {
          "withinWindow": {
            "type": "integer",
            "format": "int32"
          },
          "outsideWindow": {
            "type": "integer",
            "format": "int32"
          },
          "unknown": {
            "type": "integer",
            "format": "int32"
          },
          "withinWindowShare": {
            "type": [
              "null",
              "number"
