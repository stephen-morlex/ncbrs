            "type": "string"
          },
          "lastEventProcessedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "registrations": {
            "type": "integer",
            "format": "int32"
          },
          "heldAwaitingRegistration": {
            "type": "integer",
            "format": "int32"
          }
        }
