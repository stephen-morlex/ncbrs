            "format": "double"
          }
        }
      },
      "TimeToConfirmation": {
        "required": [
          "confirmed",
          "stillUnconfirmed",
          "medianDays",
          "byFacilityTier"
        ],
        "type": "object",
        "properties": {
          "confirmed": {
            "type": "integer",
            "format": "int32"
          },
          "stillUnconfirmed": {
            "type": "integer",
            "format": "int32"
          },
          "medianDays": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "byFacilityTier": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TierTimeToConfirmation"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "description": "A Keycloak access token for a district officer or ministry admin.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "NCBRS.Consumer"
    }
  ]
}