        "properties": {
          "liveBirths": {
            "type": "integer",
            "format": "int32"
          },
          "fetalDeaths": {
            "type": "integer",
            "format": "int32"
          },
          "vitalEventTypeUnknown": {
            "type": "integer",
            "format": "int32"
          },
          "annulled": {
            "type": "integer",
            "format": "int32"
          },
          "male": {
            "type": "integer",
            "format": "int32"
          },
          "female": {
            "type": "integer",
            "format": "int32"
          },
          "sexRatio": {
            "type": [
