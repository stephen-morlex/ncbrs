        "required": [
          "period",
          "districtId",
          "registrations",
          "timeliness",
          "timeToConfirmation",
          "registrationDelay",
          "mortality",
          "sync",
          "duplicates",
          "notAvailable"
        ],
        "type": "object",
        "properties": {
          "period": {
            "$ref": "#/components/schemas/ReportingPeriod"
