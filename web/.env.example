# Copy to .env.local, which is gitignored. Vite exposes every VITE_* variable
# to the browser bundle, so nothing secret belongs in this file -- and nothing
# here is: a public OIDC client has no secret by design, and the authority is
# a URL the browser has to know anyway.
VITE_KEYCLOAK_AUTHORITY=http://localhost:8080/realms/ncbrs
VITE_KEYCLOAK_CLIENT_ID=ncbrs-web

# The two services. Separate because they are separately deployed: the
# consumer serves the dashboard from its own read model, and a reporting
# outage is not a registration outage.
VITE_API_BASE_URL=http://localhost:5259
VITE_CONSUMER_BASE_URL=http://localhost:5281
