# openapi-typescript 7.13 still declares `peer typescript@^5.x` and this
# project is on TypeScript 6. The range is stale rather than accurate -- it
# generates correctly here, and the committed types typecheck under tsc 6,
# which the CI job proves on every run.
#
# Blunt, and worth removing: this relaxes peer checking for the whole tree,
# not just that one package, so a genuinely incompatible pair could install
# quietly. npm has no way to waive a single peer range. Drop this the moment
# openapi-typescript widens its range.
legacy-peer-deps=true
