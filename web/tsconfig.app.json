{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Resolves "@/components/ui/button" the way shadcn's generated imports
       expect. Mirrored in vite.config.ts, because the compiler and the
       bundler each resolve it themselves and neither reads the other's
       config.

       No `baseUrl`: shadcn's install guide still pairs one with `paths`,
       but TypeScript 6 deprecates it (TS5101) and 7 removes it. Without it
       `paths` resolves relative to this file, which is what we want
       anyway. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting. `strict` is set explicitly rather than left to whatever the
       TypeScript default happens to be: this client renders legal records,
       and an implicit `any` on a birth record shows up as a blank field on
       screen rather than as a failed build. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
